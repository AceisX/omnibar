#include <windows.h>

// RT_MANIFEST = 24. Il manifest e' quello che rende l'app Per-Monitor V2 e la
// tiene a asInvoker: entrambe cose che non devono dipendere dai flag del linker.
1 24 "omnibar.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "OmniBar - barra contestuale per Windows"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "omnibar"
            VALUE "OriginalFilename", "omnibar.exe"
            VALUE "ProductName", "OmniBar"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
